	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "B6-ADF-CI"
		},
		"ManagerTrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/ad861e8d-f67e-4638-846f-3c6c79d539b5/resourceGroups/B6-RG-CI/providers/Microsoft.Storage/storageAccounts/b6blobstorage"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Json4",
								"type": "DatasetReference"
							},
							"name": "sourceDL"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DelimitedText4",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "pivot1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustID as string,",
						"          Product as string,",
						"          Sales as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> sourceDL",
						"sourceDL pivot(groupBy(CustID),",
						"     pivotBy(Product),",
						"     Totalsales = sum(toInteger(Sales)),",
						"     columnNaming: '$N$V',",
						"     lateral: true) ~> pivot1",
						"pivot1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow2')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Scddataset2",
								"type": "DatasetReference"
							},
							"name": "SOURCEDATALAKE"
						},
						{
							"dataset": {
								"referenceName": "AzureSqlTable2",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable3",
								"type": "DatasetReference"
							},
							"name": "sinkDB"
						},
						{
							"dataset": {
								"referenceName": "AzureSqlTable4",
								"type": "DatasetReference"
							},
							"name": "sinkDBexistRecords"
						}
					],
					"transformations": [
						{
							"name": "derivedColumncsv"
						},
						{
							"name": "derivedColumnsql"
						},
						{
							"name": "existshashcode"
						},
						{
							"name": "derivedColumncsvactive"
						},
						{
							"name": "selectcsv"
						},
						{
							"name": "existsEMPID"
						},
						{
							"name": "existsHC"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "alterRowActive"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> SOURCEDATALAKE",
						"source(output(",
						"          SURRKEY as integer,",
						"          EMP_ID as integer,",
						"          FNAME as string,",
						"          SALARY as integer,",
						"          LOC as string,",
						"          IS_ACTIVE as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> source1",
						"SOURCEDATALAKE derive(Hashcode = md5(Employee_ID,First_Name,Salary,Location)) ~> derivedColumncsv",
						"source1 derive(Hashcode = md5(EMP_ID,FNAME,SALARY,LOC)) ~> derivedColumnsql",
						"derivedColumncsv, derivedColumnsql exists(derivedColumncsv@Hashcode == derivedColumnsql@Hashcode,",
						"     negate:true,",
						"     broadcast: 'auto')~> existshashcode",
						"existshashcode derive(Is_Active = 1,",
						"     partitionBy('hash', 1)) ~> derivedColumncsvactive",
						"derivedColumncsvactive select(mapColumn(",
						"          Employee_ID,",
						"          First_Name,",
						"          Salary,",
						"          Location,",
						"          Is_Active",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcsv",
						"derivedColumnsql, derivedColumncsv exists(EMP_ID == Employee_ID,",
						"     negate:false,",
						"     broadcast: 'auto')~> existsEMPID",
						"existsEMPID, existshashcode exists(derivedColumnsql@Hashcode == derivedColumncsv@Hashcode,",
						"     negate:true,",
						"     broadcast: 'auto')~> existsHC",
						"existsHC derive(IS_ACTIVE = 0,",
						"     partitionBy('hash', 1)) ~> derivedColumn1",
						"derivedColumn1 alterRow(updateIf(true())) ~> alterRowActive",
						"alterRowActive select(mapColumn(",
						"          SURRKEY,",
						"          EMP_ID,",
						"          FNAME,",
						"          SALARY,",
						"          LOC,",
						"          IS_ACTIVE",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"selectcsv sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          SURRKEY as integer,",
						"          EMP_ID as integer,",
						"          FNAME as string,",
						"          SALARY as integer,",
						"          LOC as string,",
						"          IS_ACTIVE as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          EMP_ID = Employee_ID,",
						"          FNAME = First_Name,",
						"          SALARY = Salary,",
						"          LOC = Location,",
						"          IS_ACTIVE = Is_Active",
						"     ),",
						"     partitionBy('hash', 1)) ~> sinkDB",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          SURRKEY as integer,",
						"          EMP_ID as integer,",
						"          FNAME as string,",
						"          SALARY as integer,",
						"          LOC as string,",
						"          IS_ACTIVE as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:false,",
						"     updateable:true,",
						"     upsertable:false,",
						"     keys:['SURRKEY'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> sinkDBexistRecords"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflowtransormations')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DelimitedText6",
								"type": "DatasetReference"
							},
							"name": "sourcedata"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DelimitedText7",
								"type": "DatasetReference"
							},
							"name": "DESTINATIONSINK"
						}
					],
					"transformations": [
						{
							"name": "SELECTEDCOLUMNS"
						},
						{
							"name": "FILTERROWS"
						},
						{
							"name": "split1"
						},
						{
							"name": "AGGREGATEINVOICE"
						}
					],
					"scriptLines": [
						"source(output(",
						"          InvoiceNo as integer,",
						"          StockCode as string,",
						"          Description as string,",
						"          Quantity as integer,",
						"          InvoiceDate as timestamp,",
						"          UnitPrice as integer,",
						"          CustomerID as string,",
						"          Country as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> sourcedata",
						"sourcedata select(mapColumn(",
						"          InvoiceNo,",
						"          Description,",
						"          InvoiceDate,",
						"          UnitPrice,",
						"          CustomerID,",
						"          Country",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SELECTEDCOLUMNS",
						"SELECTEDCOLUMNS filter(InvoiceNo!=537669,",
						"     partitionBy('hash', 1)) ~> FILTERROWS",
						"FILTERROWS split(Country=='United Kingdom',",
						"     Country=='Germany',",
						"     disjoint: false,",
						"     partitionBy('hash', 1)) ~> split1@(UK, GER, Other)",
						"split1@UK aggregate(groupBy(InvoiceNo),",
						"     UnitPrice = sum(UnitPrice),",
						"     partitionBy('hash', 1)) ~> AGGREGATEINVOICE",
						"AGGREGATEINVOICE sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          InvoiceNo as string,",
						"          StockCode as string,",
						"          Description as string,",
						"          Quantity as string,",
						"          InvoiceDate as string,",
						"          UnitPrice as string,",
						"          CustomerID as string,",
						"          Country as string",
						"     ),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> DESTINATIONSINK"
					]
				}
			},
			"dependsOn": []
		},
