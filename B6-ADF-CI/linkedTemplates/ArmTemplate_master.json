		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://Akvmysqlkey.vault.azure.net/"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"Ls_azuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-db-b6.database.windows.net"
		},
		"Ls_azuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azuredb"
		},
		"Ls_azuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AZURESQL"
		},
		"MYSQL_ON_PREMISES_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "127.0.0.1"
		},
		"MYSQL_ON_PREMISES_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azure"
		},
		"MYSQL_ON_PREMISES_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"ls_aws_s3_properties_typeProperties_accessKeyId": {
			"type": "string",
			"defaultValue": "AKIAQ62M5XEINBCGCI5C"
		},
