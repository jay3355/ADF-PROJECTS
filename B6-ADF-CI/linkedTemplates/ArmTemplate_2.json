		{
			"name": "[concat(parameters('factoryName'), '/SCD3_DATAFLOW')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Staging_Dataset",
								"type": "DatasetReference"
							},
							"name": "srcStaging"
						},
						{
							"dataset": {
								"referenceName": "Target_dataset",
								"type": "DatasetReference"
							},
							"name": "srctarget"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable5",
								"type": "DatasetReference"
							},
							"name": "sinkInsert"
						},
						{
							"dataset": {
								"referenceName": "AzureSqlTable6",
								"type": "DatasetReference"
							},
							"name": "sinkUpdate"
						}
					],
					"transformations": [
						{
							"name": "join1"
						},
						{
							"name": "splitNewAndChanged"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "alterInsert"
						},
						{
							"name": "alterUpdate"
						}
					],
					"scriptLines": [
						"source(output(",
						"          customer_id as integer,",
						"          name as string,",
						"          current_city as string,",
						"          previous_city as string,",
						"          action_flag as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> srcStaging",
						"source(output(",
						"          customer_id as integer,",
						"          name as string,",
						"          current_city as string,",
						"          previous_city as string,",
						"          effective_date as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srctarget",
						"srcStaging, srctarget join(srcStaging@customer_id == srctarget@customer_id,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> join1",
						"join1 split(isNull(srctarget@customer_id),",
						"     !isNull(srctarget@customer_id) && (srcStaging@current_city != srctarget@current_city),",
						"     disjoint: false,",
						"     partitionBy('hash', 1)) ~> splitNewAndChanged@(isNew, isChanged)",
						"splitNewAndChanged@isNew derive(customer_id = splitNewAndChanged@isNew@customer_id,",
						"          name = splitNewAndChanged@isNew@name,",
						"          current_city = splitNewAndChanged@isNew@current_city,",
						"          previous_city = toString(null()),",
						"          effective_date = currentDate(),",
						"     partitionBy('hash', 1)) ~> derivedColumn1",
						"splitNewAndChanged@isChanged derive(customer_id = splitNewAndChanged@isChanged@customer_id,",
						"          name = splitNewAndChanged@isChanged@name,",
						"          current_city = splitNewAndChanged@isChanged@current_city,",
						"          previous_city = splitNewAndChanged@isChanged@previous_city,",
						"          effective_date = currentDate()) ~> derivedColumn2",
						"derivedColumn1 alterRow(insertIf(true()),",
						"     partitionBy('hash', 1)) ~> alterInsert",
						"derivedColumn2 alterRow(updateIf(true())) ~> alterUpdate",
						"alterInsert sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          customer_id as integer,",
						"          name as string,",
						"          current_city as string,",
						"          previous_city as string,",
						"          effective_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          customer_id,",
						"          name,",
						"          current_city,",
						"          previous_city,",
						"          effective_date",
						"     ),",
						"     partitionBy('hash', 1)) ~> sinkInsert",
						"alterUpdate sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          customer_id as integer,",
						"          name as string,",
						"          current_city as string,",
						"          previous_city as string,",
						"          effective_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkUpdate"
					]
				}
			},
			"dependsOn": []
		}
	]
}